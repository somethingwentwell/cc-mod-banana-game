# Banana server admin token: used for PUT /content, POST /codes, PUT /stock, GET /claims, GET /stats
ADMIN_TOKEN=change-me-long-random

# The LLM gateway players register on. newapi (QuantumNous/new-api) or oneapi (songquanpeng/one-api).
GATEWAY_KIND=newapi
GATEWAY_URL=http://new-api:3000
# After the first login to New API as admin: Settings -> Personal -> System Access Token. Paste it here.
GATEWAY_TOKEN=
# Quota units the gateway counts per $1 (both default to 500000).
GATEWAY_QUOTA_PER_USD=500000

GATEWAY_SESSION_SECRET=change-me-session-secret
TZ=UTC
# DOMAIN=example.com   # for the optional Caddy service
